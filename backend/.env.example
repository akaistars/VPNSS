# Copy to .env on the server. Never commit actual values.
PORT=8080
DATABASE_URL=postgres://spider:change-me@127.0.0.1:5432/spider_vpn
JWT_SECRET=replace-with-at-least-32-random-bytes
CODE_PEPPER=replace-with-a-different-random-secret
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=spider@example.com
SMTP_PASSWORD=provider-issued-secret
MAIL_FROM=Spider VPN <no-reply@example.com>
